# Copy to .env for `pnpm dev` / `pnpm build`.
# Without these values the practice playground at / still works;
# sign-in pages show that the backend is not configured.

# Supabase project URL and browser-safe publishable key ("anon" key in older projects).
# Local stack: run `pnpm db:start`, then copy "API URL" and "Publishable key" from `pnpm exec supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the secret / service_role key in a VITE_* variable or commit it.
# It is only needed by `pnpm teacher:create` (set in the shell, see README)
# and is provided to Edge Functions automatically by Supabase.
